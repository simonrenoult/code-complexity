{
  "name": "code-complexity",
  "version": "4.4.2",
  "description": "Measure the churn/complexity score. Higher values mean hotspots where refactorings should happen.",
  "author": {
    "name": "Simon Renoult",
    "email": "contact@simonrenoult.me"
  },
  "engines": {
    "node": "23"
  },
  "main": "dist/src/lib",
  "types": "dist/src/lib/types.d.ts",
  "bin": {
    "code-complexity": "dist/bin/code-complexity.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/simonrenoult/code-complexity"
  },
  "bugs": {
    "url": "https://github.com/simonrenoult/code-complexity/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "eslint --ext .ts .",
    "prepare": "npm run lint && npm run build",
    "postversion": "git push --tags",
    "pretest": "npm run lint",
    "test": "node --test --require=ts-node/register test/**/*.ts"
  },
  "keywords": [
    "quality",
    "complexity",
    "churn",
    "refactoring",
    "sloc",
    "commit"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/core": "7.28.3",
    "@babel/plugin-transform-typescript": "7.28.0",
    "cli-table3": "0.6.5",
    "commander": "10.0.1",
    "debug": "4.4.1",
    "escomplex": "2.0.0-alpha",
    "esprima": "4.0.1",
    "micromatch": "4.0.8",
    "node-sloc": "0.2.1"
  },
  "devDependencies": {
    "@babel/preset-env": "7.28.3",
    "@types/babel__core": "^7.20.5",
    "@types/debug": "4.1.12",
    "@types/micromatch": "4.0.9",
    "@typescript-eslint/eslint-plugin": "5.42.1",
    "@typescript-eslint/parser": "5.42.1",
    "eslint": "8.27.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-promise": "6.1.1",
    "prettier": "2.8.8",
    "ts-node": "10.9.2",
    "typescript": "4.9.5"
  },
  "bundleDependencies": [
    "esprima"
  ]
}
